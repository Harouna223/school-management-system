# ============================================================
# Dockerfile - Backend Spring Boot (multi-stage)
# Usage : docker build -f docker/Dockerfile.backend -t school-backend .
# ============================================================

# ---- Étape 1 : compilation ----
FROM maven:3.9-eclipse-temurin-26 AS build
WORKDIR /app
COPY backend-springboot/pom.xml .
# Le cache Maven (BuildKit) survit aux coupures reseau : relancer le build
# reprend les telechargements au lieu de tout refaire depuis zero.
#
# Les deux commandes reessayent en cas de reponse 429 : le cache `--mount` ne
# survit PAS d'une execution CI a l'autre (il n'est pas exporte vers le cache
# GHA), donc chaque build retélécharge tout l'arbre de dependances. Depuis que
# la CI construit les images a chaque pull request, Maven Central a repondu
# "429 Too Many Requests" et fait echouer un build dont le code etait sain.
#
# ATTENTION, mesure du 2026-11-02 : ces proprietes `maven.wagon.http.*` ne
# couvrent PAS le chemin qui echoue reellement. `dependency:go-offline` passe par
# le resolver Aether, pas par le transport Wagon, et le 429 a encore fait tomber
# `main` sur la resolution du parent POM (spring-boot-starter-parent:3.5.16) :
#
#   Could not transfer artifact ... status code: 429, reason phrase: Too Many Requests
#
# Le reessai n'a donc jamais eu lieu. La vraie correction est de faire survivre
# `~/.m2/repository` d'un build a l'autre (cache GHA monte dans le build), pas
# d'empiler des proprietes Wagon. En attendant, la frequence est reduite par
# `paths-ignore` dans ci.yml : un commit de documentation ne reconstruit plus
# les images.
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B \
        -Dmaven.wagon.http.retryHandler.count=5 \
        -Dmaven.wagon.http.retryHandler.class=standard \
        dependency:go-offline
COPY backend-springboot/src ./src
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B \
        -Dmaven.wagon.http.retryHandler.count=5 \
        -Dmaven.wagon.http.retryHandler.class=standard \
        clean package -DskipTests

# ---- Étape 2 : image d'exécution ----
FROM eclipse-temurin:25-jre
RUN apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar

# ------------------------------------------------------------------
# Execution SANS privileges root.
#
# Par defaut un conteneur tourne en root : une faille d'execution de code
# (upload malveillant, deserialisation, dependance compromise) donne alors
# root DANS le conteneur, et le volume des fichiers pedagogiques est monte
# en ecriture juste a cote. L'UID 10001 n'a aucun droit sur l'hote.
#
# Corollaire a ne pas oublier : le repertoire des fichiers pedagogiques est
# un volume monte depuis l'hote, il doit appartenir a 10001:10001. C'est
# deploy/install.sh (creation) et deploy/update.sh (migration d'une
# installation existante) qui s'en chargent ; sans cela les televersements
# echouent en « Permission denied ».
# ------------------------------------------------------------------
ARG APP_UID=10001
ARG APP_GID=10001
RUN groupadd --system --gid "${APP_GID}" app \
    && useradd --system --uid "${APP_UID}" --gid app --no-create-home \
               --home-dir /app --shell /usr/sbin/nologin app \
    && mkdir -p /app/uploads \
    && chown -R app:app /app

USER app
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "app.jar"]
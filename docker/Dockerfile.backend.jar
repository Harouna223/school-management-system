# ============================================================
# Dockerfile - Backend Spring Boot depuis un JAR PRECONSTRUIT
#
# Variante utilisee par deploy/offline/build-bundle.sh avec USE_LOCAL_JAR=1
# lorsque le reseau est trop instable pour recompiler dans Docker.
# Le jar doit etre produit sur la machine de build :
#   mvn -f backend-springboot/pom.xml -DskipTests package
#
# Contexte de build attendu : un repertoire contenant app.jar.
# ============================================================
FROM eclipse-temurin:25-jre
RUN apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY app.jar app.jar

# Meme execution non privilegiee que Dockerfile.backend : les deux variantes
# doivent se comporter a l'identique, sinon la version hors ligne
# reintroduirait silencieusement le conteneur root.
ARG APP_UID=10001
ARG APP_GID=10001
RUN groupadd --system --gid "${APP_GID}" app \
    && useradd --system --uid "${APP_UID}" --gid app --no-create-home \
               --home-dir /app --shell /usr/sbin/nologin app \
    && mkdir -p /app/uploads \
    && chown -R app:app /app

USER app
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "app.jar"]

# Variables d'environnement pour docker-compose
# Copier vers .env puis adapter si besoin : cp docker/.env.example docker/.env

# Testcontainers / base de test
# ⚠️ DB_PORT=3308, pas 3306 : un MySQL local écoute déjà sur 3306, et même sur
# 3307 entre en conflit (le port 3307 était occupé par un deuxième mysqld local,
# ce qui a paralysé les tests d'intégration jusqu'à la migration sur 3308).
# ❌ Ne jamais republier le conteneur MySQL sur les ports 3306/3307.
DB_PORT=3308
DB_PASSWORD=root
DB_NAME=school_management

# Application
# ⚠️ OBLIGATOIRE : secret de signature des jetons JWT (Base64, >= 32 octets décodés).
# Générer une valeur unique pour cette installation :
#   openssl rand -base64 48
# Ne jamais réutiliser la valeur d'une autre installation : la clé par défaut du
# dépôt est publique, quiconque la connaît pourrait forger des jetons valides.
JWT_SECRET=
# true (défaut en production) → le backend REFUSE de démarrer tant que JWT_SECRET
# est absent, vide, resté celui du dépôt, ou < 32 octets décodés.
REQUIRE_SECURE_SECRETS=true
# OBLIGATOIRE au premier démarrage : mot de passe du compte « admin ».
# Avec REQUIRE_SECURE_SECRETS=true, une valeur vide ou « Admin@123 » fait
# échouer le démarrage tant que le compte n'a pas encore été créé.
ADMIN_PASSWORD=
# Documentation interactive (/swagger-ui.html, /v3/api-docs) : false en production.
SWAGGER_ENABLED=true
SCHOOL_NAME=École Moderne de Technologie
CORS_ORIGINS=http://localhost

# Port d'exposition du frontend
FRONTEND_PORT=80
# Interface d'écoute : 0.0.0.0 en HTTP direct sur le réseau local.
# Passer à 127.0.0.1 (avec FRONTEND_PORT=8081) quand deploy/https.sh
# installe un nginx hôte qui termine le TLS et proxifie vers le conteneur.
FRONTEND_BIND=0.0.0.0

# Notifications WhatsApp aux parents (bulletin disponible / absence signalée)
# WA_ENABLED=true pour activer l'envoi réel (sinon mode simulation : messages journalisés)
# Fournisseurs : meta (WhatsApp Cloud API) ou twilio
WA_ENABLED=false
WA_PROVIDER=meta
# --- Meta Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api) ---
WA_META_TOKEN=
WA_META_PHONE_ID=
# --- Twilio WhatsApp (https://www.twilio.com/whatsapp) ---
WA_TWILIO_SID=
WA_TWILIO_TOKEN=
WA_TWILIO_FROM=

# Notifications SMS aux parents (Twilio SMS ; simulation par défaut)
SMS_ENABLED=false
SMS_TWILIO_SID=
SMS_TWILIO_TOKEN=
SMS_TWILIO_FROM=

# ---------------------------------------------------------------------------
# Module « Cours et ressources » (vidéos + PDF)
# ---------------------------------------------------------------------------

# Répertoire PERSISTANT des fichiers pédagogiques, sur l'hôte.
# Doit exister avant le démarrage :
#   sudo mkdir -p /srv/sahel-edu/uploads && sudo chown -R $USER:$USER /srv/sahel-edu
# Il doit être sauvegardé séparément (voir docs/COURS_VIDEO_PDF.md).
UPLOAD_HOST_DIR=/srv/sahel-edu/uploads

# Port du backend publié sur la boucle locale uniquement (diagnostic).
BACKEND_PORT=8080

# Limites par nature de fichier. À ajuster selon le disque du serveur et le
# débit Internet réel de l'établissement.
COURSE_MAX_VIDEO_MB=500
COURSE_MAX_PDF_MB=25
# Durée de validité des liens de lecture (doit couvrir une séance de travail).
COURSE_TOKEN_TTL_MINUTES=120
# Limites Tomcat/Spring, doivent rester >= COURSE_MAX_VIDEO_MB (+ marge).
MAX_FILE_SIZE=512MB
MAX_REQUEST_SIZE=512MB

# Envoi d'e-mails aux parents (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

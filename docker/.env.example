# Variables d'environnement pour docker-compose
# Copier vers .env puis adapter si besoin : cp docker/.env.example docker/.env

# Testcontainers / base de test
# ⚠️ DB_PORT=3308, pas 3306 : un MySQL local écoute déjà sur 3306, et même sur
# 3307 entre en conflit (le port 3307 était occupé par un deuxième mysqld local,
# ce qui a paralysé les tests d'intégration jusqu'à la migration sur 3308).
# ❌ Ne jamais republier le conteneur MySQL sur les ports 3306/3307.
DB_PORT=3308
DB_PASSWORD=root
DB_NAME=school_management

# Application
JWT_SECRET=Y2hhbmdlLXRoaXMtc2VjcmV0LWtleS1pbi1wcm9kdWN0aW9uLXdpdGgtYTM3LWNyYXdhbGxlbg==
# D15 : passer à true en PRODUCTION → le backend REFUSE de démarrer tant que
# JWT_SECRET n'est pas une valeur forte (ni le défaut, ni < 32 octets décodés).
REQUIRE_SECURE_SECRETS=false
ADMIN_PASSWORD=Admin@123
SCHOOL_NAME=École Moderne de Technologie
CORS_ORIGINS=http://localhost

# Port d'exposition du frontend
FRONTEND_PORT=80

# Notifications WhatsApp aux parents (bulletin disponible / absence signalée)
# WA_ENABLED=true pour activer l'envoi réel (sinon mode simulation : messages journalisés)
# Fournisseurs : meta (WhatsApp Cloud API) ou twilio
WA_ENABLED=false
WA_PROVIDER=meta
# --- Meta Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api) ---
WA_META_TOKEN=
WA_META_PHONE_ID=
# --- Twilio WhatsApp (https://www.twilio.com/whatsapp) ---
WA_TWILIO_SID=
WA_TWILIO_TOKEN=
WA_TWILIO_FROM=

# Notifications SMS aux parents (Twilio SMS ; simulation par défaut)
SMS_ENABLED=false
SMS_TWILIO_SID=
SMS_TWILIO_TOKEN=
SMS_TWILIO_FROM=

# Envoi d'e-mails aux parents (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

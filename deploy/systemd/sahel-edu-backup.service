[Unit]
Description=Sahel Edu - sauvegarde quotidienne (base de donnees + fichiers pedagogiques)
Documentation=file:///opt/sahel-edu/docs/DEPLOIEMENT_UBUNTU.md
Requires=docker.service
After=docker.service sahel-edu.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/sahel-edu-backup
# Chemins et cible de la copie hors site, ecrits par deploy/install.sh (ou
# deploy/update.sh). Le « - » rend le fichier facultatif : sans lui le service
# refuserait de demarrer au lieu de signaler clairement OFFSITE_DIR manquant.
EnvironmentFile=-/etc/sahel-edu/backup.env
# Priorite basse : la sauvegarde ne doit pas concurrencer les utilisateurs.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Une sauvegarde lente ne doit pas etre tuee au bout de 90 s (defaut systemd).
TimeoutStartSec=3600

target/
node_modules/
dist/
*.jar
# Dockerfile de la variante "jar preconstruit" : malgre son extension, ce
# n'est pas un artefact de build et il doit etre versionne.
!docker/Dockerfile.backend.jar
*.log
.env
.vscode/
.idea/
*.iml
.DS_Store
docker-compose.override.yml
backend-springboot/target/
frontend-react/node_modules/
frontend-react/dist/

# Residus de build Vite : fichiers temporaires de config laisses par une execution
# interrompue, et dossiers de verification hors production (dist-verify, dist-check...).
frontend-react/vite.config.js.timestamp-*.mjs
frontend-react/dist-*/

# Artefacts créés par des commandes terminales accidentelles
/[Help
/cd
/git
/mvn
/_mvn_ver.txt
/_node_ver.txt
/_build_backend.log
/backend-springboot/erreur.txt
/_*.txt
/_*.log
/_*.ps1
/_*.js
/_*.json
/_*.png
/_*.tar
/_*.gz
/_*.err
/_*.exit
/_*.py

# Journaux de verification laisses par une session precedente : conserves sur le
# disque (utiles au diagnostic) mais jamais versionnes.
/.verify-*

# Etat local des outils : depot Maven hors ligne, memoire de l'assistant.
/.m2/
/.workbuddy-ai/

# Sauvegardes de bases de donnees (contiennent des donnees reelles) : ne jamais commiter.
database/*backup*.sql
database/*-backup.sql

# Bundle de deploiement hors ligne : images Docker et paquets .deb volumineux.
# Les scripts et la documentation restent versionnes, pas les artefacts.
/deploy/offline/dist/
/deploy/offline/images/
/deploy/offline/docker-debs/